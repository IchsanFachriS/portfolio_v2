# ===== App =====
NEXT_PUBLIC_SITE_URL=https://ichsanfachri.my.id
# Buat dengan: openssl rand -base64 48
AUTH_SECRET=ganti-dengan-string-acak-minimal-32-karakter

# ===== Database (PostgreSQL) =====
DATABASE_URL=postgresql://portfolio:PASSWORD@localhost:5432/portfolio

# Akun admin awal (dipakai saat `npm run db:seed`, bisa diganti lewat menu Akun)
ADMIN_EMAIL=ichsanfachrisrj@gmail.com
ADMIN_PASSWORD=ganti-password-kuat

# ===== Object Storage (S3-compatible) =====
# Contoh endpoint: https://s3.ap-southeast-1.amazonaws.com | https://<accountid>.r2.cloudflarestorage.com | https://is3.cloudhost.id
S3_ENDPOINT=
S3_REGION=auto
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# URL publik untuk akses file, tanpa slash di akhir (CDN / custom domain / public bucket URL)
S3_PUBLIC_URL=
# true untuk MinIO / beberapa provider lokal
S3_FORCE_PATH_STYLE=false
# true jika bucket butuh ACL public-read per objek
S3_PUBLIC_ACL=false
S3_PREFIX=portfolio
